# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/multimodal_rag

# General Settings
PROJECT_NAME="Multimodal Hybrid RAG System"
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Machine Learning & Vector Store Settings
EMBEDDING_MODEL=all-MiniLM-L6-v2
# EMBEDDING_MODEL_PATH=backend/models/fine_tuned_minilm
CLIP_MODEL=openai/clip-vit-base-patch32
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RERANKER_MODEL_PATH=backend/models/fine_tuned_reranker

FAISS_INDEX_PATH=data/indexes/faiss.index
FAISS_IMAGE_INDEX_PATH=data/indexes/faiss_image.index
BM25_INDEX_PATH=data/indexes/bm25_index.pkl

# LLM API Keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Web Search API Keys
TAVILY_API_KEY=your_tavily_api_key_here
WEB_SEARCH_THRESHOLD=0.65
TAVILY_MAX_RESULTS=5
